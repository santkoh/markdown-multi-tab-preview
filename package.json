{
  "name": "markdown-multi-tab-preview",
  "displayName": "Markdown Multi Tab Preview",
  "description": "Preview multiple Markdown files simultaneously with independent preview panels",
  "version": "0.10.1",
  "publisher": "santkoh",
  "engines": {
    "vscode": "^1.118.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/santkoh/markdown-multi-tab-preview"
  },
  "bugs": {
    "url": "https://github.com/santkoh/markdown-multi-tab-preview/issues"
  },
  "homepage": "https://github.com/santkoh/markdown-multi-tab-preview#readme",
  "icon": "media/icon.png",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "workspaceContains:**/*.md",
    "workspaceContains:**/*.markdown"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "vsce package --no-dependencies",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
    "test": "pnpm run compile && playwright test"
  },
  "contributes": {
    "commands": [
      {
        "command": "mdMultiTabPreview.showPreview",
        "title": "Markdown Multi Tab Preview: Show Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "mdMultiTabPreview.showEditor",
        "title": "Markdown Multi Tab Preview: Show Editor",
        "icon": "$(edit)"
      },
      {
        "command": "mdMultiTabPreview.togglePreview",
        "title": "Markdown Multi Tab Preview: Toggle Preview"
      },
      {
        "command": "mdMultiTabPreview.showDiffPreview",
        "title": "Markdown Multi Tab Preview: Show Rich Diff (vs HEAD)",
        "icon": "$(git-compare)"
      },
      {
        "command": "mdMultiTabPreview.findInPreview",
        "title": "Markdown Multi Tab Preview: Find in Preview",
        "icon": "$(search)"
      }
    ],
    "keybindings": [
      {
        "command": "mdMultiTabPreview.togglePreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == markdown || resourceExtname == .md || resourceExtname == .markdown || activeWebviewPanelId == mdMultiTabPreview"
      },
      {
        "command": "mdMultiTabPreview.findInPreview",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeWebviewPanelId == mdMultiTabPreview || activeWebviewPanelId == mdMultiTabDiffPreview"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mdMultiTabPreview.showPreview",
          "when": "editorLangId == markdown || resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation"
        },
        {
          "command": "mdMultiTabPreview.showEditor",
          "when": "activeWebviewPanelId == mdMultiTabPreview",
          "group": "navigation"
        },
        {
          "command": "mdMultiTabPreview.showDiffPreview",
          "when": "editorLangId == markdown || resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation"
        },
        {
          "command": "mdMultiTabPreview.findInPreview",
          "when": "activeWebviewPanelId == mdMultiTabPreview || activeWebviewPanelId == mdMultiTabDiffPreview",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "mdMultiTabPreview.findInPreview",
          "when": "activeWebviewPanelId == mdMultiTabPreview || activeWebviewPanelId == mdMultiTabDiffPreview"
        }
      ]
    },
    "configuration": {
      "title": "Markdown Multi Tab Preview",
      "properties": {
        "mdMultiTabPreview.autoPreview": {
          "type": "boolean",
          "default": true,
          "description": ".mdファイルを開いた時にプレビューを自動表示"
        },
        "mdMultiTabPreview.retainContextWhenHidden": {
          "type": "boolean",
          "default": true,
          "description": "非表示時もプレビューの状態を保持する（無効にするとメモリ使用量が減少しますが、タブ切り替え時に再レンダリングが発生します）"
        },
        "mdMultiTabPreview.allowRemoteImages": {
          "type": "boolean",
          "default": true,
          "description": "プレビューでリモート画像（https://）の読み込みを許可する（無効にするとプライバシーが向上しますが、外部画像が表示されません）"
        },
        "mdMultiTabPreview.colorDecorator": {
          "type": "boolean",
          "default": true,
          "description": "プレビューでカラーコードの横に色見本を表示する"
        },
        "mdMultiTabPreview.gitDecorations": {
          "type": "boolean",
          "default": true,
          "description": "プレビューの各ブロック左端に Git 変更マーカー（追加: 緑 / 変更: 青の帯）を表示する"
        },
        "mdMultiTabPreview.toc.enabled": {
          "type": "boolean",
          "default": true,
          "description": "プレビューにOutline（目次）サイドバーを表示する"
        },
        "mdMultiTabPreview.toc.maxDepth": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 6,
          "description": "Outlineに表示する見出しの最大レベル（1〜6）"
        },
        "mdMultiTabPreview.theme.preset": {
          "type": "string",
          "enum": ["soft", "classic"],
          "default": "soft",
          "description": "プレビューの外観プリセット。soft: 角丸 + 柔らかい枠線（推奨）、classic: v0.7.5 までの直線的なデザイン",
          "enumDescriptions": [
            "soft: 角丸 + 柔らかい枠線（推奨）",
            "classic: 従来デザイン"
          ]
        },
        "mdMultiTabPreview.codeFontFamily": {
          "type": "string",
          "default": "",
          "markdownDescription": "コードブロック／インラインコードのフォントを上書きする CSS `font-family` 値（例: `Sarasa Mono J`、`'HackGen', monospace`）。空の場合は同梱の CJK 等幅フォント **Sarasa Mono**（OFL-1.1）を既定で使用し、全角・半角混在の ASCII アートや罫線表が Preview でも桁揃えされます。上書きする場合は、桁揃えを保ちたいなら CJK の全角が半角の正確に 2 倍幅で設計された等幅フォントを指定してください。"
        }
      }
    }
  },
  "pnpm": {
    "overrides": {
      "@azure/identity@>=4.0.0 <4.14.1": "^4.14.1",
      "@vscode/vsce>minimatch": "^11.0.1",
      "mermaid>katex": "^0.18.2"
    }
  },
  "packageManager": "pnpm@10.29.3",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^25.9.9",
    "@types/vscode": "~1.118.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.3.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@panzoom/panzoom": "^4.6.2",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^17.0.6",
    "mermaid": "^11.17.2"
  }
}
